{
  "name": "nodoubt",
  "version": "0.1.0",
  "private": true,
  "description": "Project No Doubt monorepo",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "scripts": {
    "dev:server": "pnpm --filter @nodoubt/app-server start:dev",
    "dev:mobile:web": "cd apps/app-mobile && flutter run -d chrome",
    "dev:mobile:web-wasm": "cd apps/app-mobile && flutter run -d chrome --wasm",
    "dev:admin": "cd apps/app-admin && python3 -m http.server 4173",
    "build:server": "pnpm --filter @nodoubt/app-server build",
    "seed:dev": "pnpm --filter @nodoubt/app-server seed:dev",
    "prisma:generate": "pnpm --filter @nodoubt/app-server prisma:generate",
    "prisma:migrate": "pnpm --filter @nodoubt/app-server prisma:migrate"
  }
}
